<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dustwatch" model="ir.module.category">
        <field name="name">DustWatch Solar O&amp;M</field>
        <field name="description">Manage solar site soiling detection, cleaning schedules, and telemetry.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_dustwatch_user" model="res.groups">
        <field name="name">Technician / Cleaning Crew</field>
        <field name="category_id" ref="module_category_dustwatch"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_dustwatch_manager" model="res.groups">
        <field name="name">Operations Manager / Administrator</field>
        <field name="category_id" ref="module_category_dustwatch"/>
        <field name="implied_ids" eval="[(4, ref('group_dustwatch_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
