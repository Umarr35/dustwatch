<odoo>
    <record id="dustwatch_weather_forecast_view_list" model="ir.ui.view">
        <field name="name">dustwatch.weather.forecast.list</field>
        <field name="model">dustwatch.weather.forecast</field>
        <field name="arch" type="xml">
            <list class="o_dustwatch_view" create="0" edit="0" delete="0" default_order="forecast_date asc, issued_at desc">
                <field name="site_id"/>
                <field name="forecast_date"/>
                <field name="issued_at"/>
                <field name="weather_description"/>
                <field name="peak_sun_hours" sum="Total forecast peak-sun hours"/>
                <field name="forecast_expected_kwh" sum="Total weather-planned output"/>
                <field name="precipitation_mm"/>
                <field name="precipitation_probability"/>
                <field name="humidity_max"/>
                <field name="dew_risk_hours"/>
                <field name="wind_speed_max"/>
                <field name="provider"/>
            </list>
        </field>
    </record>

    <record id="dustwatch_weather_forecast_view_form" model="ir.ui.view">
        <field name="name">dustwatch.weather.forecast.form</field>
        <field name="model">dustwatch.weather.forecast</field>
        <field name="arch" type="xml">
            <form string="Weather forecast" class="o_dustwatch_view" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <label for="site_id"/>
                        <h1><field name="site_id"/></h1>
                    </div>
                    <group>
                        <group string="Forecast" name="weather">
                            <field name="forecast_date"/>
                            <field name="issued_at"/>
                            <field name="provider"/>
                            <field name="weather_code"/>
                            <field name="weather_description"/>
                        </group>
                        <group string="Weather inputs" name="weather_inputs">
                            <field name="precipitation_mm"/>
                            <field name="precipitation_probability"/>
                            <field name="humidity_mean"/>
                            <field name="humidity_max"/>
                            <field name="dew_risk_hours"/>
                            <field name="wind_speed_max"/>
                        </group>
                    </group>
                    <group string="Solar output plan" name="solar_plan">
                        <field name="shortwave_radiation_mj"/>
                        <field name="peak_sun_hours"/>
                        <field name="forecast_expected_kwh"/>
                    </group>
                    <div class="o_dw_weather_notice" role="note">
                        Forecast output is capacity × forecast peak-sun-hours × the site's performance factor. It uses horizontal solar radiation as an estimate, not a panel-tilt simulation. Actual readings are compared separately; weather never changes a cleaning job automatically. Weather data attribution: <a href="https://open-meteo.com/" target="_blank" rel="noreferrer">Open-Meteo (CC BY 4.0)</a>.
                    </div>
                    <separator string="Readings matched to this day-ahead run"/>
                    <field name="reading_ids" readonly="1" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="date"/>
                            <field name="actual_kwh"/>
                            <field name="forecast_expected_kwh"/>
                            <field name="forecast_variance_kwh"/>
                            <field name="forecast_error_pct"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dustwatch_weather_forecast_view_search" model="ir.ui.view">
        <field name="name">dustwatch.weather.forecast.search</field>
        <field name="model">dustwatch.weather.forecast</field>
        <field name="arch" type="xml">
            <search>
                <field name="site_id"/>
                <filter name="filter_upcoming" string="Upcoming" domain="[('forecast_date', '&gt;=', context_today())]"/>
                <group>
                    <filter name="group_by_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_by_date" string="Forecast date" context="{'group_by': 'forecast_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dustwatch_weather_forecast" model="ir.actions.act_window">
        <field name="name">Weather outlook</field>
        <field name="res_model">dustwatch.weather.forecast</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="dustwatch_weather_forecast_view_search"/>
        <field name="context">{'search_default_filter_upcoming': 1}</field>
    </record>

    <record id="dustwatch_weather_signal_view_list" model="ir.ui.view">
        <field name="name">dustwatch.weather.signal.list</field>
        <field name="model">dustwatch.weather.signal</field>
        <field name="arch" type="xml">
            <list class="o_dustwatch_view" create="0" edit="0" delete="0" default_order="signal_date desc, signal_strength desc">
                <field name="signal_date"/>
                <field name="region_bucket" string="Coarse region"/>
                <field name="event_type" widget="badge" decoration-warning="event_type == 'possible_dust_event'" decoration-info="event_type == 'weather_related_output_drop'" decoration-muted="event_type == 'regional_output_anomaly'"/>
                <field name="signal_strength" widget="progressbar"/>
                <field name="site_count"/>
                <field name="customer_count"/>
                <field name="mean_shortfall_pct"/>
                <field name="forecast_alignment"/>
                <field name="analysed_at"/>
            </list>
        </field>
    </record>

    <record id="dustwatch_weather_signal_view_form" model="ir.ui.view">
        <field name="name">dustwatch.weather.signal.form</field>
        <field name="model">dustwatch.weather.signal</field>
        <field name="arch" type="xml">
            <form string="Regional weather signal" class="o_dustwatch_view" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Signal" name="signal">
                            <field name="signal_date"/>
                            <field name="region_bucket"/>
                            <field name="event_type"/>
                            <field name="signal_strength"/>
                            <field name="analysed_at"/>
                        </group>
                        <group string="Aggregated evidence" name="evidence">
                            <field name="site_count"/>
                            <field name="customer_count"/>
                            <field name="mean_shortfall_pct"/>
                            <field name="mean_wind_speed"/>
                            <field name="mean_precipitation_mm"/>
                            <field name="mean_humidity_pct"/>
                            <field name="forecast_alignment"/>
                        </group>
                    </group>
                    <field name="summary" nolabel="1"/>
                    <div class="o_dw_weather_notice is-warning" role="note">
                        Experimental, anonymized anomaly indicator only. It is not a verified dust-storm forecast and does not expose customer names or site records.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dustwatch_weather_signal" model="ir.actions.act_window">
        <field name="name">Regional weather signals</field>
        <field name="res_model">dustwatch.weather.signal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="dustwatch_weather_settings_view_form" model="ir.ui.view">
        <field name="name">dustwatch.weather.settings.form</field>
        <field name="model">dustwatch.weather.settings</field>
        <field name="arch" type="xml">
            <form string="Weather settings" class="o_dustwatch_view">
                <sheet>
                    <div class="o_dw_weather_notice" role="note">
                        Weather calls are off until a DustWatch manager enables them. Enabling sends site latitude and longitude to Open-Meteo. The public preview endpoint is for non-commercial evaluation only; use the commercial endpoint and its key before operating this as a paid service. Weather attribution: <a href="https://open-meteo.com/" target="_blank" rel="noreferrer">Open-Meteo (CC BY 4.0)</a>.
                    </div>
                    <group>
                        <group string="Forecast provider" name="provider">
                            <field name="weather_enabled"/>
                            <field name="provider_mode" invisible="not weather_enabled"/>
                            <field name="api_key" password="True" invisible="not weather_enabled or provider_mode != 'commercial'"/>
                        </group>
                        <group string="Fleet learning" name="fleet_learning">
                            <field name="peer_signals_enabled"/>
                            <div class="text-muted" colspan="2">
                                When enabled, the daily job stores coarse-region counts and average output gaps only. It does not store site or customer names in the shared signal.
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_and_refresh" type="object" string="Save and refresh now" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dustwatch_weather_settings" model="ir.actions.act_window">
        <field name="name">Weather settings</field>
        <field name="res_model">dustwatch.weather.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="dustwatch_weather_settings_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
