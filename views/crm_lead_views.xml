<odoo>
    <record id="crm_lead_view_form_dustwatch" model="ir.ui.view">
        <field name="name">crm.lead.form.dustwatch</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_dustwatch_sites"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sun-o"
                        groups="dustwatch.group_dustwatch_crew"
                        invisible="not partner_id or not dustwatch_site_count">
                    <field name="dustwatch_site_count" widget="statinfo" string="Solar sites"/>
                </button>
                <button name="action_open_dustwatch_map"
                        type="object"
                        class="oe_stat_button o_dustwatch_brand_btn"
                        icon="fa-map-marker"
                        groups="dustwatch.group_dustwatch_crew"
                        invisible="not partner_id or not dustwatch_site_count">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Live map</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
